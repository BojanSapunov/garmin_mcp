# Copy to .env for local development. In Azure these are Container Apps secrets.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres@/garmin?host=/absolute/path/to/repo/.pgdata

# Personal API key from https://connect.garmin.com/app/settings/personalApiToken
GARMIN_API_KEY=
GARMIN_KEY_EXPIRES=2027-10-26

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL=
SESSION_SECRET=   # python -c "import secrets; print(secrets.token_urlsafe(48))"

# Skip Google sign-in locally until the OAuth client exists (refused outside APP_ENV=local)
AUTH_DEV_BYPASS=true
